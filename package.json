{
  "name": "zenn-article",
  "version": "1.0.0",
  "description": "Zenn に投稿している技術記事を GitHub 連携で管理するリポジトリ",
  "scripts": {
    "lint": "textlint \"articles/**/*.md\" \"books/**/*.md\"",
    "lint:fix": "textlint --fix \"articles/**/*.md\" \"books/**/*.md\"",
    "lint:md": "markdownlint-cli2 \"articles/**/*.md\" \"books/**/*.md\"",
    "lint:links": "textlint -c .textlintrc.links.json \"articles/**/*.md\" \"books/**/*.md\"",
    "format": "prettier --write \"**/*.md\"",
    "preview": "zenn preview",
    "prepare": "husky"
  },
  "lint-staged": {
    "{articles,books}/**/*.md": [
      "textlint --fix",
      "markdownlint-cli2",
      "prettier --write"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Corvus400/zenn-article.git"
  },
  "keywords": [],
  "author": "",
  "license": "CC-BY-4.0",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Corvus400/zenn-article/issues"
  },
  "homepage": "https://github.com/Corvus400/zenn-article#readme",
  "dependencies": {
    "zenn-cli": "^0.4.8"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "markdownlint-cli2": "^0.22.1",
    "prettier": "^3.8.3",
    "textlint": "^15.7.1",
    "textlint-filter-rule-comments": "^1.3.0",
    "textlint-rule-no-dead-link": "^6.2.2",
    "textlint-rule-preset-ja-technical-writing": "^12.0.2",
    "textlint-rule-prh": "^6.1.0"
  }
}
